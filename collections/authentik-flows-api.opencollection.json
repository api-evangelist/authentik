{
  "opencollection": "1.0.0",
  "info": {
    "name": "authentik Core Flows API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Flows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List flows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authentik_host}/api/v3/flows/instances/"
          },
          "docs": "List flows"
        },
        {
          "info": {
            "name": "Create flow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{authentik_host}/api/v3/flows/instances/"
          },
          "docs": "Create flow"
        },
        {
          "info": {
            "name": "List flow stage bindings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authentik_host}/api/v3/flows/bindings/"
          },
          "docs": "List flow stage bindings"
        }
      ]
    }
  ],
  "bundled": true
}